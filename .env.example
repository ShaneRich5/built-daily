# Local MCP (stdio). Copy to .env.local — never commit real keys.

# Path to a Firebase service account JSON with Firestore read access.
# Relative paths are resolved from the repo root.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Optional: paste the service account JSON instead of a file path.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Your Firebase Auth uid (Firestore path: users/{uid}/sessions).
MCP_USER_UID=
