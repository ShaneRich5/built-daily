# Copy to .env.local for development — never commit real keys.

# --- Firebase web app (client-side, safe to expose) ---
# Firebase console → Project settings → General → Your apps → SDK setup.
# When these are unset the app renders its signed-out shell, which is how CI
# runs the Playwright smoke suite.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-side: MCP + API routes) ---
# Path to a service account JSON with Firestore read access.
# Relative paths are resolved from the repo root.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Vercel: paste the service account JSON as a single-line env var instead of a file.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# --- MCP ---
# Your Firebase Auth uid (Firestore path: users/{uid}/sessions).
MCP_USER_UID=

# Shared secret for ChatGPT / Claude. Required on /api/mcp (fail closed if missing).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_BEARER_TOKEN=

# --- Sentry ---
SENTRY_AUTH_TOKEN=
