# Local MCP (stdio) and remote HTTP MCP. Copy to .env — never commit real keys.

# Path to a Firebase service account JSON. The Admin SDK bypasses
# firestore.rules entirely, so this key can read and write any user's data —
# keep it local and rotate it if it is ever exposed.
# Relative paths are resolved from the repo root. Save the file under this
# exact name: .gitignore covers serviceAccount.json, so it can't be committed.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Vercel: paste the service account JSON as a single-line env var instead of a file.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Your Firebase Auth uid (Firestore path: users/{uid}/sessions).
MCP_USER_UID=

# Shared secret for ChatGPT / Claude. Required on /api/mcp (fail closed if missing).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_BEARER_TOKEN=

SENTRY_AUTH_TOKEN=

# Test-account login for Playwright MCP UI review (docs/PLAYWRIGHT_MCP.md).
# Use a throwaway account, never your real one.
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=