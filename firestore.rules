rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function nonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function optionalString(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    /** JS clients often write whole numbers as floats; accept either. */
    function isIntLike(v) {
      return v is int || (v is float && v == int(v));
    }

    function validExerciseNotesMap(m) {
      return m == null || (m is map && m.size() <= 30);
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
          == request.auth.uid;
    }

    function validDateKey(v) {
      return v == null
        || (v is string
          && v.size() == 10
          && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    /** Structural checks only; client + app code validate nested sets. */
    function validWorkoutSessionWrite() {
      let d = request.resource.data;
      return d.keys().hasAll([
            'status', 'title', 'planId', 'workoutDate', 'workoutTime',
            'startedAt', 'endedAt',
            'activeDurationSec', 'workoutNote', 'exerciseNotesByLineId',
            'lines', 'exerciseCount', 'setCount', 'previewExerciseNames'
          ])
        && d.status in ['completed', 'in_progress']
        && nonEmptyString(d.title, 200)
        && (d.planId == null || (d.planId is string && d.planId.size() <= 128))
        && (d.workoutDate == null
            || (d.workoutDate is string
              && d.workoutDate.size() == 10
              && d.workoutDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (d.workoutTime == null
            || (d.workoutTime is string
              && d.workoutTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && d.startedAt is timestamp
        && (d.activeDurationSec == null || (d.activeDurationSec is int && d.activeDurationSec >= 0 && d.activeDurationSec <= 86400))
        && optionalString(d.workoutNote, 500)
        && validExerciseNotesMap(d.exerciseNotesByLineId)
        && d.lines is list && d.lines.size() <= 40
        && d.exerciseCount is int && d.exerciseCount == d.lines.size()
        && d.setCount is int && d.setCount >= 0
        && d.previewExerciseNames is list && d.previewExerciseNames.size() <= 5
        && (
          (d.status == 'completed'
            && d.endedAt is timestamp
            && d.setCount >= 0)
          || (d.status == 'in_progress'
            && d.endedAt == null
            && d.setCount >= 0)
        );
    }

    function validScheduledWorkoutCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
            'dateKey', 'label', 'planId', 'exerciseIds', 'createdAt'
          ])
        && d.dateKey is string
        && d.dateKey.size() == 10
        && d.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && nonEmptyString(d.label, 200)
        && (d.planId == null || (d.planId is string && d.planId.size() <= 128))
        && d.exerciseIds is list
        && d.exerciseIds.size() <= 40
        && d.createdAt is timestamp;
    }

    function validGroupCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
            'name', 'createdBy', 'createdAt', 'inviteCode', 'memberCount'
          ])
        && nonEmptyString(d.name, 100)
        && d.createdBy == request.auth.uid
        && d.createdAt is timestamp
        && nonEmptyString(d.inviteCode, 12)
        && isIntLike(d.memberCount)
        && d.memberCount == 1;
    }

    function validMemberCreate(groupId) {
      let d = request.resource.data;
      return d.keys().hasAll([
            'uid', 'displayName', 'role', 'joinedAt',
            'lastWorkoutDateKey', 'lastWorkoutAt', 'currentStreak'
          ])
        && d.uid == request.auth.uid
        && nonEmptyString(d.displayName, 80)
        && d.role in ['owner', 'member']
        && d.joinedAt is timestamp
        && validDateKey(d.lastWorkoutDateKey)
        && (d.lastWorkoutAt == null || d.lastWorkoutAt is timestamp)
        && isIntLike(d.currentStreak)
        && d.currentStreak >= 0
        && (
          (d.role == 'owner'
            && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
              == request.auth.uid)
          || d.role == 'member'
        );
    }

    function validMemberSelfSignalUpdate() {
      let d = request.resource.data;
      let before = resource.data;
      return d.uid == before.uid
        && d.uid == request.auth.uid
        && d.role == before.role
        && d.joinedAt == before.joinedAt
        && nonEmptyString(d.displayName, 80)
        && validDateKey(d.lastWorkoutDateKey)
        && (d.lastWorkoutAt == null || d.lastWorkoutAt is timestamp)
        && isIntLike(d.currentStreak)
        && d.currentStreak >= 0;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validWorkoutSessionWrite();
        allow update: if isOwner(userId)
          && resource.data.status in ['completed', 'in_progress']
          && validWorkoutSessionWrite();
        allow delete: if isOwner(userId)
          && resource.data.status in ['completed', 'in_progress'];
      }

      match /plans/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'name', 'createdAt', 'updatedAt', 'source', 'lines'
          ])
          && nonEmptyString(request.resource.data.name, 200)
          && request.resource.data.source in ['custom', 'starter_copy']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0
          && request.resource.data.lines.size() <= 40;
        allow delete: if isOwner(userId);
      }

      match /scheduledWorkouts/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validScheduledWorkoutCreate();
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /groupMemberships/{groupId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'groupId', 'nameSnapshot', 'role', 'joinedAt'
          ])
          && request.resource.data.groupId == groupId
          && nonEmptyString(request.resource.data.nameSnapshot, 100)
          && request.resource.data.role in ['owner', 'member']
          && request.resource.data.joinedAt is timestamp;
        // Owner of the group may clear indexes when deleting the group.
        allow delete: if isOwner(userId) || isGroupOwner(groupId);
      }

      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && settingsId == 'progress'
          && request.resource.data.keys().hasAll([
            'weeklyGoal', 'goalWeightLbs', 'updatedAt'
          ])
          && (request.resource.data.weeklyGoal is int
            || (request.resource.data.weeklyGoal is float
              && request.resource.data.weeklyGoal == int(request.resource.data.weeklyGoal)))
          && request.resource.data.weeklyGoal in [2, 3, 4, 5, 6, 7]
          && (
            !('movementGoalDays' in request.resource.data)
            || (
              (request.resource.data.movementGoalDays is int
                || (request.resource.data.movementGoalDays is float
                  && request.resource.data.movementGoalDays
                    == int(request.resource.data.movementGoalDays)))
              && request.resource.data.movementGoalDays in [3, 4, 5, 6, 7]
            )
          )
          && (request.resource.data.goalWeightLbs == null
            || (request.resource.data.goalWeightLbs is number
              && request.resource.data.goalWeightLbs > 0
              && request.resource.data.goalWeightLbs <= 1000))
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /bodyWeight/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'dateKey', 'weightLbs', 'createdAt'
          ])
          && request.resource.data.dateKey is string
          && request.resource.data.dateKey.size() == 10
          && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.weightLbs is number
          && request.resource.data.weightLbs > 0
          && request.resource.data.weightLbs <= 1000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if isOwner(userId);
      }

      match /activities/{activityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'activityTypeId', 'activityDate', 'activityTime',
            'durationMin', 'distanceMiles', 'locationName', 'notes',
            'visibility', 'source', 'startedAt', 'endedAt',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.activityTypeId is string
          && request.resource.data.activityTypeId.size() > 0
          && request.resource.data.activityTypeId.size() <= 64
          && request.resource.data.activityDate is string
          && request.resource.data.activityDate.size() == 10
          && request.resource.data.activityDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (request.resource.data.activityTime == null
            || (request.resource.data.activityTime is string
              && request.resource.data.activityTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
          && (request.resource.data.durationMin == null
            || (isIntLike(request.resource.data.durationMin)
              && request.resource.data.durationMin > 0
              && request.resource.data.durationMin <= 1440))
          && (request.resource.data.distanceMiles == null
            || (request.resource.data.distanceMiles is number
              && request.resource.data.distanceMiles > 0
              && request.resource.data.distanceMiles <= 500))
          && optionalString(request.resource.data.locationName, 120)
          && optionalString(request.resource.data.notes, 400)
          && request.resource.data.visibility == 'private'
          && request.resource.data.source == 'manual'
          && (request.resource.data.startedAt == null
            || request.resource.data.startedAt is timestamp)
          && (request.resource.data.endedAt == null
            || request.resource.data.endedAt is timestamp)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update, delete: if isOwner(userId);
      }
    }

    function groupCoreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && nonEmptyString(request.resource.data.name, 100)
        && nonEmptyString(request.resource.data.inviteCode, 12)
        && isIntLike(request.resource.data.memberCount)
        && request.resource.data.memberCount >= 0
        && request.resource.data.memberCount <= 12;
    }

    /** Join: +1 count only. Leave: −1 count only (same batch as member write). */
    function memberCountJoinOrLeave(groupId) {
      return groupCoreUnchanged()
        && request.resource.data.name == resource.data.name
        && request.resource.data.inviteCode == resource.data.inviteCode
        && (
          (request.resource.data.memberCount == resource.data.memberCount + 1
            && !exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)))
          || (request.resource.data.memberCount == resource.data.memberCount - 1
            && isGroupMember(groupId)
            && !isGroupOwner(groupId))
        );
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isSignedIn() && validGroupCreate();
      allow update: if isSignedIn()
        && groupCoreUnchanged()
        && (
          isGroupOwner(groupId)
          || memberCountJoinOrLeave(groupId)
        );
      allow delete: if isGroupOwner(groupId);

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && validMemberCreate(groupId)
          && get(/databases/$(database)/documents/groups/$(groupId)).data.memberCount < 12;
        allow update: if isSignedIn()
          && memberId == request.auth.uid
          && validMemberSelfSignalUpdate();
        allow delete: if isSignedIn()
          && (memberId == request.auth.uid || isGroupOwner(groupId));
      }
    }

    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'groupId', 'createdBy', 'createdAt', 'active'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.active is bool
        && nonEmptyString(request.resource.data.groupId, 128);
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.active is bool;
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }
  }
}
