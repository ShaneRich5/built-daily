rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function nonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function optionalString(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    /** JS clients often write whole numbers as floats; accept either. */
    function isIntLike(v) {
      return v is int || (v is float && v == int(v));
    }

    function validExerciseNotesMap(m) {
      return m == null || (m is map && m.size() <= 30);
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
          == request.auth.uid;
    }

    function validDateKey(v) {
      return v == null
        || (v is string
          && v.size() == 10
          && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    /** Structural checks only; client + app code validate nested sets. */
    function validWorkoutSessionWrite() {
      let d = request.resource.data;
      return d.keys().hasAll([
            'status', 'title', 'planId', 'workoutDate', 'workoutTime',
            'startedAt', 'endedAt',
            'activeDurationSec', 'workoutNote', 'exerciseNotesByLineId',
            'lines', 'exerciseCount', 'setCount', 'previewExerciseNames'
          ])
        && d.status in ['completed', 'in_progress']
        && nonEmptyString(d.title, 200)
        && (d.planId == null || (d.planId is string && d.planId.size() <= 128))
        && (d.workoutDate == null
            || (d.workoutDate is string
              && d.workoutDate.size() == 10
              && d.workoutDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (d.workoutTime == null
            || (d.workoutTime is string
              && d.workoutTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && d.startedAt is timestamp
        && (d.activeDurationSec == null || (d.activeDurationSec is int && d.activeDurationSec >= 0 && d.activeDurationSec <= 86400))
        && optionalString(d.workoutNote, 500)
        && validExerciseNotesMap(d.exerciseNotesByLineId)
        && d.lines is list && d.lines.size() <= 40
        && d.exerciseCount is int && d.exerciseCount == d.lines.size()
        && d.setCount is int && d.setCount >= 0
        && d.previewExerciseNames is list && d.previewExerciseNames.size() <= 5
        && (
          (d.status == 'completed'
            && d.endedAt is timestamp
            && d.setCount >= 0)
          || (d.status == 'in_progress'
            && d.endedAt == null
            && d.setCount >= 0)
        );
    }

    function validUserProfileWrite() {
      let d = request.resource.data;
      return d.keys().hasAll([
            'displayName', 'timezone', 'units',
            'onboardingCompletedAt', 'createdAt', 'updatedAt'
          ])
        && nonEmptyString(d.displayName, 80)
        && nonEmptyString(d.timezone, 64)
        && d.units in ['imperial', 'metric']
        && (d.onboardingCompletedAt == null
            || d.onboardingCompletedAt is timestamp)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    /** `sessionId` links a completed entry to the workout that finished it. */
    function validScheduledWorkoutFields() {
      let d = request.resource.data;
      return d.keys().hasAll([
            'dateKey', 'label', 'planId', 'exerciseIds',
            'status', 'sessionId', 'createdAt'
          ])
        // null = Unscheduled (an idea or leftover with no day yet).
        && validDateKey(d.dateKey)
        && nonEmptyString(d.label, 200)
        && (d.planId == null || (d.planId is string && d.planId.size() <= 128))
        && d.exerciseIds is list
        && d.exerciseIds.size() <= 40
        && d.status in ['planned', 'completed', 'skipped']
        && (
          d.sessionId == null
          || (d.status == 'completed' && nonEmptyString(d.sessionId, 128))
        )
        // Optional link to a plan together ("I'm in"); absent on ordinary rows.
        && (!('sharedPlanId' in d) || d.sharedPlanId == null || nonEmptyString(d.sharedPlanId, 128))
        && (!('groupId' in d) || d.groupId == null || nonEmptyString(d.groupId, 128));
    }

    function validScheduledWorkoutCreate() {
      return validScheduledWorkoutFields()
        && request.resource.data.createdAt is timestamp;
    }

    function validScheduledWorkoutUpdate() {
      return validScheduledWorkoutFields()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validGroupCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
            'name', 'createdBy', 'createdAt', 'inviteCode', 'memberCount'
          ])
        && nonEmptyString(d.name, 100)
        && d.createdBy == request.auth.uid
        && d.createdAt is timestamp
        && nonEmptyString(d.inviteCode, 12)
        && isIntLike(d.memberCount)
        && d.memberCount == 1
        && validKindAndCap(d);
    }

    /** Max members for a group doc; groups created before buddies hold 12. */
    function groupCap(d) {
      return d.get('maxMembers', 12);
    }

    /** A buddy is a group capped at 2; a group caps at 12. Both fields optional (older docs). */
    function validKindAndCap(d) {
      return d.get('kind', 'group') in ['group', 'buddy']
        && (d.get('kind', 'group') == 'buddy' ? groupCap(d) == 2 : groupCap(d) == 12);
    }

    function validWeeklyGoal(v) {
      return isIntLike(v) && v in [2, 3, 4, 5, 6, 7];
    }

    function validMemberCreate(groupId) {
      let d = request.resource.data;
      return d.keys().hasAll([
            'uid', 'displayName', 'role', 'joinedAt',
            'lastWorkoutDateKey', 'lastWorkoutAt', 'currentStreak', 'weeklyGoal'
          ])
        && d.uid == request.auth.uid
        && nonEmptyString(d.displayName, 80)
        && d.role in ['owner', 'member']
        && d.joinedAt is timestamp
        && validDateKey(d.lastWorkoutDateKey)
        && (d.lastWorkoutAt == null || d.lastWorkoutAt is timestamp)
        && isIntLike(d.currentStreak)
        && d.currentStreak >= 0
        && validWeeklyGoal(d.weeklyGoal)
        && validMemberTogetherFields(d)
        && (
          (d.role == 'owner'
            && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
              == request.auth.uid)
          || d.role == 'member'
        );
    }

    /**
     * Groups Together fields on a member row: days trained, the workout name,
     * and the next 7 days of plans (day + label). All optional so rows written
     * before them stay valid. Never sets, weights, notes or body weight.
     */
    function validMemberTogetherFields(d) {
      return (!('trainedDays' in d) || (d.trainedDays is list && d.trainedDays.size() <= 14))
        && (!('lastWorkoutLabel' in d) || optionalString(d.lastWorkoutLabel, 80))
        && (!('upcomingPlans' in d) || (d.upcomingPlans is list && d.upcomingPlans.size() <= 14));
    }

    function validMemberSelfSignalUpdate() {
      let d = request.resource.data;
      let before = resource.data;
      return validMemberTogetherFields(d)
        && d.uid == before.uid
        && d.uid == request.auth.uid
        && d.role == before.role
        && d.joinedAt == before.joinedAt
        && nonEmptyString(d.displayName, 80)
        && validDateKey(d.lastWorkoutDateKey)
        && (d.lastWorkoutAt == null || d.lastWorkoutAt is timestamp)
        && isIntLike(d.currentStreak)
        && d.currentStreak >= 0
        && validWeeklyGoal(d.weeklyGoal);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserProfileWrite();
      allow delete: if isOwner(userId);

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validWorkoutSessionWrite();
        allow update: if isOwner(userId)
          && resource.data.status in ['completed', 'in_progress']
          && validWorkoutSessionWrite();
        allow delete: if isOwner(userId)
          && resource.data.status in ['completed', 'in_progress'];
      }

      match /plans/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'name', 'createdAt', 'updatedAt', 'source', 'lines'
          ])
          && nonEmptyString(request.resource.data.name, 200)
          && request.resource.data.source in ['custom', 'starter_copy']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0
          && request.resource.data.lines.size() <= 40;
        allow delete: if isOwner(userId);
      }

      match /scheduledWorkouts/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validScheduledWorkoutCreate();
        allow update: if isOwner(userId) && validScheduledWorkoutUpdate();
        allow delete: if isOwner(userId);
      }

      match /groupMemberships/{groupId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'groupId', 'nameSnapshot', 'role', 'joinedAt'
          ])
          && request.resource.data.groupId == groupId
          && nonEmptyString(request.resource.data.nameSnapshot, 100)
          && request.resource.data.role in ['owner', 'member']
          && request.resource.data.joinedAt is timestamp
          // Private name for a gym buddy before they join (only its owner reads this doc).
          && optionalString(request.resource.data.get('buddyNickname', null), 80);
        // Owner of the group may clear indexes when deleting the group.
        allow delete: if isOwner(userId) || isGroupOwner(groupId);
      }

      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && settingsId == 'progress'
          && request.resource.data.keys().hasAll([
            'weeklyGoal', 'goalWeightLbs', 'updatedAt'
          ])
          && (request.resource.data.weeklyGoal is int
            || (request.resource.data.weeklyGoal is float
              && request.resource.data.weeklyGoal == int(request.resource.data.weeklyGoal)))
          && request.resource.data.weeklyGoal in [2, 3, 4, 5, 6, 7]
          && (
            !('movementGoalDays' in request.resource.data)
            || (
              (request.resource.data.movementGoalDays is int
                || (request.resource.data.movementGoalDays is float
                  && request.resource.data.movementGoalDays
                    == int(request.resource.data.movementGoalDays)))
              && request.resource.data.movementGoalDays in [3, 4, 5, 6, 7]
            )
          )
          && (request.resource.data.goalWeightLbs == null
            || (request.resource.data.goalWeightLbs is number
              && request.resource.data.goalWeightLbs > 0
              && request.resource.data.goalWeightLbs <= 1000))
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /bodyWeight/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'dateKey', 'weightLbs', 'createdAt'
          ])
          && request.resource.data.dateKey is string
          && request.resource.data.dateKey.size() == 10
          && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.weightLbs is number
          && request.resource.data.weightLbs > 0
          && request.resource.data.weightLbs <= 1000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if isOwner(userId);
      }

      match /activities/{activityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'activityTypeId', 'activityDate', 'activityTime',
            'durationMin', 'distanceMiles', 'locationName', 'notes',
            'visibility', 'source', 'startedAt', 'endedAt',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.activityTypeId is string
          && request.resource.data.activityTypeId.size() > 0
          && request.resource.data.activityTypeId.size() <= 64
          && request.resource.data.activityDate is string
          && request.resource.data.activityDate.size() == 10
          && request.resource.data.activityDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (request.resource.data.activityTime == null
            || (request.resource.data.activityTime is string
              && request.resource.data.activityTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
          && (request.resource.data.durationMin == null
            || (isIntLike(request.resource.data.durationMin)
              && request.resource.data.durationMin > 0
              && request.resource.data.durationMin <= 1440))
          && (request.resource.data.distanceMiles == null
            || (request.resource.data.distanceMiles is number
              && request.resource.data.distanceMiles > 0
              && request.resource.data.distanceMiles <= 500))
          && optionalString(request.resource.data.locationName, 120)
          && optionalString(request.resource.data.notes, 400)
          && request.resource.data.visibility == 'private'
          && request.resource.data.source == 'manual'
          && (request.resource.data.startedAt == null
            || request.resource.data.startedAt is timestamp)
          && (request.resource.data.endedAt == null
            || request.resource.data.endedAt is timestamp)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update, delete: if isOwner(userId);
      }
    }

    function groupCoreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && nonEmptyString(request.resource.data.name, 100)
        && nonEmptyString(request.resource.data.inviteCode, 12)
        && isIntLike(request.resource.data.memberCount)
        && request.resource.data.memberCount >= 0
        && validKindAndCap(request.resource.data)
        && request.resource.data.memberCount <= groupCap(request.resource.data);
    }

    /** Join: +1 count only. Leave: −1 count only (same batch as member write). */
    function memberCountJoinOrLeave(groupId) {
      return groupCoreUnchanged()
        && request.resource.data.name == resource.data.name
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.get('kind', 'group') == resource.data.get('kind', 'group')
        && groupCap(request.resource.data) == groupCap(resource.data)
        && (
          (request.resource.data.memberCount == resource.data.memberCount + 1
            && !exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)))
          || (request.resource.data.memberCount == resource.data.memberCount - 1
            && isGroupMember(groupId)
            && !isGroupOwner(groupId))
        );
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isSignedIn() && validGroupCreate();
      allow update: if isSignedIn()
        && groupCoreUnchanged()
        && (
          isGroupOwner(groupId)
          || memberCountJoinOrLeave(groupId)
        );
      allow delete: if isGroupOwner(groupId);

      match /members/{memberId} {
        // A user can always read their own row (even before it exists) so a
        // prospective joiner can check "am I already a member?" without
        // needing group membership first. Other members' rows stay
        // member-only.
        allow read: if isGroupMember(groupId) || memberId == request.auth.uid;
        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && validMemberCreate(groupId)
          && get(/databases/$(database)/documents/groups/$(groupId)).data.memberCount
            < groupCap(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow update: if isSignedIn()
          && memberId == request.auth.uid
          && validMemberSelfSignalUpdate();
        allow delete: if isSignedIn()
          && (memberId == request.auth.uid || isGroupOwner(groupId));
      }

      // One tiny doc per cheer; the doc id itself encodes identity
      // (`{dateKey}_{toUid}_{fromUid}`), so a member can only ever create or
      // delete their own cheer and rules stay a plain field-equality check —
      // no workout details are stored or exposed here, just a show-up nudge.
      match /cheers/{cheerId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.groupId == groupId
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid is string
          && request.resource.data.toUid != request.auth.uid
          && request.resource.data.dateKey is string
          && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && cheerId == request.resource.data.dateKey
            + '_' + request.resource.data.toUid
            + '_' + request.resource.data.fromUid;
        allow delete: if isSignedIn() && resource.data.fromUid == request.auth.uid;
      }

      // Plans together: day, optional time / where / note, a template's
      // exercise names + set counts (never weights), and who's going.
      // Members read; anyone in the group can create one with only
      // themselves going; everyone can add or remove only their OWN uid.
      match /plans/{planId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && validSharedPlanFields(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp
          && request.resource.data.going == [request.auth.uid]
          && request.resource.data.goingAt.keys().hasOnly([request.auth.uid]);
        allow update: if isGroupMember(groupId)
          && validSharedPlanFields(groupId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && goingChangeIsSelfOnly()
          && (
            resource.data.createdBy == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going', 'goingAt'])
          );
        allow delete: if isSignedIn()
          && (resource.data.createdBy == request.auth.uid || isGroupOwner(groupId));
      }
    }

    function validSharedPlanFields(groupId) {
      let d = request.resource.data;
      return d.keys().hasAll([
            'groupId', 'dateKey', 'time', 'where', 'label', 'exercises', 'note',
            'createdBy', 'createdByName', 'going', 'goingAt', 'createdAt'
          ])
        && d.groupId == groupId
        && d.dateKey is string && validDateKey(d.dateKey)
        && (d.time == null
          || (d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && optionalString(d.where, 80)
        && nonEmptyString(d.label, 80)
        && d.exercises is list && d.exercises.size() <= 20
        && optionalString(d.note, 140)
        && nonEmptyString(d.createdByName, 80)
        && d.going is list && d.going.size() <= 12
        && d.goingAt is map && d.goingAt.size() <= 12;
    }

    /** `going` may only gain or lose the caller's own uid, and `goingAt` only the caller's key. */
    function goingChangeIsSelfOnly() {
      let before = resource.data.going.toSet();
      let after = request.resource.data.going.toSet();
      let me = [request.auth.uid].toSet();
      return (after == before.union(me) || after == before.difference(me))
        && request.resource.data.goingAt.diff(resource.data.goingAt).affectedKeys()
          .hasOnly([request.auth.uid]);
    }

    match /inviteCodes/{code} {
      // Look up one code you already have; never list them all.
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'groupId', 'createdBy', 'createdAt', 'active'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.active is bool
        && nonEmptyString(request.resource.data.groupId, 128);
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.active is bool;
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    /**
     * What a signed-out visitor with an invite link may see: group name,
     * first names, counts, and the plans someone chose to invite to (day,
     * name, time, where, going first names). Readable by exact code only.
     */
    match /invitePreviews/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isGroupMember(request.resource.data.groupId)
        && validInvitePreview(code);
      // `resource == null`: rotating or deleting a group clears a preview that may never have been written.
      allow delete: if isSignedIn()
        && (resource == null || isGroupMember(resource.data.groupId));
    }

    function validInvitePreview(code) {
      let d = request.resource.data;
      let invite = get(/databases/$(database)/documents/inviteCodes/$(code)).data;
      return d.keys().hasOnly([
            'groupId', 'groupName', 'kind', 'invitedByName', 'memberFirstNames',
            'memberCount', 'workoutsThisWeek', 'plans', 'updatedAt'
          ])
        && invite.groupId == d.groupId
        && invite.active == true
        && nonEmptyString(d.groupName, 100)
        && d.kind in ['group', 'buddy']
        && nonEmptyString(d.invitedByName, 80)
        && d.memberFirstNames is list && d.memberFirstNames.size() <= 12
        && isIntLike(d.memberCount) && d.memberCount >= 0 && d.memberCount <= 12
        && isIntLike(d.workoutsThisWeek) && d.workoutsThisWeek >= 0 && d.workoutsThisWeek <= 200
        && d.plans is map && d.plans.size() <= 10
        && d.updatedAt is timestamp;
    }

    function validPublicProfileWrite() {
      let d = request.resource.data;
      return d.keys().hasAll([
            'displayName', 'profilePublic', 'currentStreak',
            'workoutsThisWeek', 'lastWorkoutDateKey', 'activityByDay',
            'updatedAt'
          ])
        && nonEmptyString(d.displayName, 80)
        && d.profilePublic is bool
        && isIntLike(d.currentStreak)
        && d.currentStreak >= 0
        && d.currentStreak <= 10000
        && isIntLike(d.workoutsThisWeek)
        && d.workoutsThisWeek >= 0
        && d.workoutsThisWeek <= 1000
        && validDateKey(d.lastWorkoutDateKey)
        && d.activityByDay is map
        && d.activityByDay.size() <= 200
        && d.updatedAt is timestamp;
    }

    /** Opt-in public slice only — never opens users/{uid}/… private data. */
    match /publicProfiles/{userId} {
      allow read: if resource.data.profilePublic == true || isOwner(userId);
      allow create, update: if isOwner(userId) && validPublicProfileWrite();
      allow delete: if isOwner(userId);
    }

    // `mcpTokens/{tokenHash}` (MCP personal access tokens, see
    // docs/MCP_MULTI_USER.md) is intentionally NOT matched here — it's
    // written and read only by the Admin SDK (app/api/mcp/tokens/route.ts,
    // mcp/tokens.ts), so it falls through to Firestore's default deny for
    // client SDK access. Do not add client rules for this collection.

    // Same deal for the OAuth authorization server's collections (see
    // docs/MCP_CHATGPT_OAUTH.md): `oauthClients/{clientId}`,
    // `oauthCodes/{codeHash}` and `oauthRefreshTokens/{tokenHash}` are
    // deliberately unmatched, so they are default-denied to client SDKs and
    // reachable only by the Admin SDK (mcp/oauth-*.ts). Authorization codes
    // and refresh tokens are credentials — never expose them to a client.
  }
}
